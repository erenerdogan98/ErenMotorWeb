@using ErenMotorWeb.UI.Core.Dtos.CategoryDto
@model IEnumerable<ResultCategoryDto>

@{
    var categories = Model?
        .Where(x => x.IsActive && x.ParentCategoryId == null)
        .ToList() ?? [];
}

<div class="nav-category">

    <button type="button" class="nav-category-button">
        <i class="fa-solid fa-bars"></i>

        <span>Kategoriler</span>

        <i class="fa-solid fa-chevron-down nav-category-arrow"></i>
    </button>


    <div class="nav-category-dropdown">

        @foreach (var category in categories)
        {
            var subCategories = Model?
            .Where(x => x.IsActive &&
            x.ParentCategoryId == category.Id)
            .ToList() ?? [];

            <div class="nav-category-item">

                <a asp-controller="Category"
                   asp-action="Detail"
                   asp-route-slug="@category.Slug"
                   class="nav-category-link">

                    <span>
                        @category.Name
                    </span>

                    @if (subCategories.Any())
                    {
                        <i class="fa-solid fa-chevron-right"></i>
                    }

                </a>


                @if (subCategories.Any())
                {
                    <div class="nav-subcategory-dropdown">

                        @foreach (var subCategory in subCategories)
                        {
                            <a asp-controller="Category"
                               asp-action="Detail"
                               asp-route-slug="@subCategory.Slug">

                                @subCategory.Name

                            </a>
                        }

                    </div>
                }

            </div>
        }

    </div>

</div>