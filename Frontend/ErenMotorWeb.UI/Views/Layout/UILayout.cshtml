@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Eren Motor</title>

    <meta name="description"
          content="Eren Motor - Bisiklet, elektrikli bisiklet, motosiklet ve yedek parça ürünleri." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/erenmotor.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- TOP BAR -->
    @await Html.PartialAsync("~/Views/LayoutPartial/_TopBar.cshtml")

    <!-- HEADER -->
    @await Html.PartialAsync("~/Views/LayoutPartial/_Header.cshtml")

    <!-- NAVBAR -->
    @await Html.PartialAsync("~/Views/LayoutPartial/_Navbar.cshtml")


    <!-- ANA SAYFA İÇERİĞİ -->
    <main>

        @RenderBody()

    </main>


    <!-- FOOTER -->
    @await Html.PartialAsync("~/Views/LayoutPartial/_Footer.cshtml")


    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>