@model ErenMotorWeb.UI.Core.Dtos.ProductDto.CreateProductDto

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
}

<div class="product-create-page">

    <!-- Sayfa Başlığı -->
    <div class="page-header">

        <div class="page-header-left">
            <h1>Yeni Ürün Ekle</h1>
            <p>Mağazanıza yeni bir ürün ekleyin.</p>
        </div>

        <div class="page-header-right">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Products"
               class="btn btn-secondary">
                ← Ürünlere Dön
            </a>
        </div>

    </div>


    <!-- Validation -->
    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <form asp-area="Admin"
          asp-controller="Product"
          asp-action="AddProduct"
          method="post">


        <!-- GENEL BİLGİLER -->
        <div class="form-card">

            <div class="form-card-header">
                <h2>Genel Bilgiler</h2>
                <p>Ürünün temel bilgilerini girin.</p>
            </div>

            <div class="form-card-body">

                <div class="form-group full-width">

                    <label asp-for="ProductName">
                        Ürün Adı
                    </label>

                    <input asp-for="ProductName"
                           class="form-control"
                           placeholder="Örn: 29x2.10 Timsah Bisiklet Dış Lastiği" />

                    <span asp-validation-for="ProductName"
                          class="field-validation">
                    </span>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Slug">
                            Slug
                        </label>

                        <input asp-for="Slug"
                               class="form-control"
                               placeholder="urun-adi-slug" />

                        <span asp-validation-for="Slug"
                              class="field-validation">
                        </span>

                        <small>
                            URL içerisinde kullanılacak ürün adresi.
                        </small>

                    </div>


                    <div class="form-group">

                        <label asp-for="ModelCode">
                            Model Kodu
                        </label>

                        <input asp-for="ModelCode"
                               class="form-control"
                               placeholder="Örn: TM-2910" />

                        <span asp-validation-for="ModelCode"
                              class="field-validation">
                        </span>

                        <small>
                            Aynı ürünün farklı renklerini gruplamak için kullanılır.
                        </small>

                    </div>

                </div>


                <div class="form-group">

                    <label>
                        Kısa Açıklama
                    </label>

                    <textarea asp-for="ShortDescription"
                              class="form-control textarea-short"
                              placeholder="Ürün hakkında kısa bir açıklama..."></textarea>

                    <span asp-validation-for="ShortDescription"
                          class="field-validation">
                    </span>

                </div>

            </div>

        </div>


        <!-- KATEGORİ / MARKA / TEDARİKÇİ / MENŞE -->
        <div class="form-card">

            <div class="form-card-header">
                <h2>Kategori ve Tedarik Bilgileri</h2>
                <p>Ürünün kategori, marka, tedarikçi ve menşe bilgilerini seçin.</p>
            </div>

            <div class="form-card-body">

                <!-- Kategori ve Marka -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="CategoryId">
                            Kategori
                        </label>

                        @await Component.InvokeAsync("CategorySelect")

                        <span asp-validation-for="CategoryId"
                              class="field-validation">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="BrandId">
                            Marka
                        </label>

                        @await Component.InvokeAsync("BrandSelect")

                        <span asp-validation-for="BrandId"
                              class="field-validation">
                        </span>

                    </div>

                </div>


                <!-- Tedarikçi ve Menşe -->
                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="SupplierId">
                            Tedarikçi
                        </label>

                        @await Component.InvokeAsync("SupplierSelect")

                        <span asp-validation-for="SupplierId"
                              class="field-validation">
                        </span>

                    </div>


                    <div class="form-group">

                        <label asp-for="OriginId">
                            Menşe
                        </label>

                        @await Component.InvokeAsync("OriginSelect")

                        <span asp-validation-for="OriginId"
                              class="field-validation">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- VARYANTLAR -->
        <div class="form-card">

            <div class="form-card-header">

                <div style="display:flex; justify-content:space-between; align-items:center; gap:20px;">

                    <div>
                        <h2>Ürün Varyantları</h2>
                        <p>
                            Ürünün renk, barkod, SKU, fiyat ve stok bilgilerini girin.
                        </p>
                    </div>

                    <button type="button"
                            class="btn btn-secondary"
                            id="addVariantBtn">
                        + Varyant Ekle
                    </button>

                </div>

            </div>


            <div class="form-card-body">

                <div id="variantsContainer">

                    <!-- İlk varyant -->
                    <div class="variant-row"
                         data-index="0">

                        <div class="variant-row-header">

                            <strong>
                                Varyant 1
                            </strong>

                        </div>


                        <div class="form-row">

                            <!-- Renk -->
                            <div class="form-group">

                                <label>
                                    Renk
                                </label>

                                <select name="Variants[0].Color"
                                        class="form-control">

                                    <option value="0">
                                        Renk Seçin
                                    </option>

                                    <option value="1">Kırmızı</option>
                                    <option value="2">Sarı</option>
                                    <option value="3">Mavi</option>
                                    <option value="4">Yeşil</option>
                                    <option value="5">Siyah</option>
                                    <option value="6">Beyaz</option>
                                    <option value="7">Gri</option>
                                    <option value="8">Turuncu</option>
                                    <option value="9">Mor</option>
                                    <option value="10">Pembe</option>
                                    <option value="11">Kahverengi</option>
                                    <option value="12">Lacivert</option>
                                    <option value="13">Bej</option>
                                    <option value="14">Gümüş</option>
                                    <option value="15">Altın</option>
                                    <option value="16">Şeffaf</option>
                                    <option value="17">Turkuaz</option>

                                </select>

                            </div>


                            <!-- Barkod -->
                            <div class="form-group">

                                <label>
                                    Barkod
                                </label>

                                <input type="text"
                                       name="Variants[0].Barcode"
                                       class="form-control"
                                       placeholder="Barkod numarası" />

                            </div>

                        </div>


                        <div class="form-row">

                            <!-- SKU -->
                            <div class="form-group">

                                <label>
                                    SKU
                                </label>

                                <input type="text"
                                       name="Variants[0].Sku"
                                       class="form-control"
                                       placeholder="Örn: TM-2910-SYH" />

                            </div>


                            <!-- Fiyat -->
                            <div class="form-group">

                                <label>
                                    Satış Fiyatı
                                </label>

                                <div class="input-with-suffix">

                                    <input type="number"
                                           name="Variants[0].Price"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="0.00" />

                                    <span>₺</span>

                                </div>

                            </div>


                            <!-- Stok -->
                            <div class="form-group">

                                <label>
                                    Stok
                                </label>

                                <input type="number"
                                       name="Variants[0].Stock"
                                       min="0"
                                       class="form-control"
                                       placeholder="0" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- AÇIKLAMA -->
        <div class="form-card">

            <div class="form-card-header">
                <h2>Ürün Açıklaması</h2>
                <p>Ürünün detaylı açıklamasını girin.</p>
            </div>

            <div class="form-card-body">

                <div class="form-group">

                    <label asp-for="Description">
                        Detaylı Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="form-control textarea-large"
                              placeholder="Ürünün detaylı açıklamasını girin..."></textarea>

                    <span asp-validation-for="Description"
                          class="field-validation">
                    </span>

                </div>

            </div>

        </div>


        <!-- ÜRÜN DURUMU -->
        <div class="form-card">

            <div class="form-card-header">
                <h2>Ürün Durumu</h2>
                <p>Ürünün mağazadaki görünürlüğünü belirleyin.</p>
            </div>

            <div class="form-card-body">

                <div class="switch-group">

                    <label class="switch-label">

                        <input asp-for="IsActive"
                               type="checkbox" />

                        <span class="switch"></span>

                        <span>
                            <strong>Aktif Ürün</strong>

                            <small>
                                Ürün mağazada aktif olarak yayınlansın.
                            </small>
                        </span>

                    </label>


                    <label class="switch-label">

                        <input asp-for="IsFeatured"
                               type="checkbox" />

                        <span class="switch"></span>

                        <span>
                            <strong>Öne Çıkan Ürün</strong>

                            <small>
                                Ürün öne çıkan ürünler arasında gösterilsin.
                            </small>
                        </span>

                    </label>

                </div>

            </div>

        </div>


        <!-- FORM ACTIONS -->
        <div class="form-actions">

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Products"
               class="btn btn-secondary">
                İptal
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Ürünü Kaydet
            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let variantIndex = 1;

        document
            .getElementById("addVariantBtn")
            .addEventListener("click", function () {

                const container =
                    document.getElementById("variantsContainer");

                const variant = document.createElement("div");

                variant.className = "variant-row";

                variant.setAttribute(
                    "data-index",
                    variantIndex
                );

                variant.innerHTML = `

                    <div class="variant-row-header"
                         style="display:flex; justify-content:space-between; align-items:center;">

                        <strong>
                            Varyant ${variantIndex + 1}
                        </strong>

                        <button type="button"
                                class="btn btn-secondary remove-variant">
                            Varyantı Sil
                        </button>

                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label>
                                Renk
                            </label>

                            <select name="Variants[${variantIndex}].Color"
                                    class="form-control">

                                <option value="0">
                                    Renk Seçin
                                </option>

                                <option value="1">Kırmızı</option>
                                <option value="2">Sarı</option>
                                <option value="3">Mavi</option>
                                <option value="4">Yeşil</option>
                                <option value="5">Siyah</option>
                                <option value="6">Beyaz</option>
                                <option value="7">Gri</option>
                                <option value="8">Turuncu</option>
                                <option value="9">Mor</option>
                                <option value="10">Pembe</option>
                                <option value="11">Kahverengi</option>
                                <option value="12">Lacivert</option>
                                <option value="13">Bej</option>
                                <option value="14">Gümüş</option>
                                <option value="15">Altın</option>
                                <option value="16">Şeffaf</option>
                                <option value="17">Turkuaz</option>

                            </select>

                        </div>


                        <div class="form-group">

                            <label>
                                Barkod
                            </label>

                            <input type="text"
                                   name="Variants[${variantIndex}].Barcode"
                                   class="form-control"
                                   placeholder="Barkod numarası" />

                        </div>

                    </div>


                    <div class="form-row">

                        <div class="form-group">

                            <label>
                                SKU
                            </label>

                            <input type="text"
                                   name="Variants[${variantIndex}].Sku"
                                   class="form-control"
                                   placeholder="Örn: TM-2910-SYH" />

                        </div>


                        <div class="form-group">

                            <label>
                                Satış Fiyatı
                            </label>

                            <div class="input-with-suffix">

                                <input type="number"
                                       name="Variants[${variantIndex}].Price"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       placeholder="0.00" />

                                <span>₺</span>

                            </div>

                        </div>


                        <div class="form-group">

                            <label>
                                Stok
                            </label>

                            <input type="number"
                                   name="Variants[${variantIndex}].Stock"
                                   min="0"
                                   class="form-control"
                                   placeholder="0" />

                        </div>

                    </div>
                `;

                container.appendChild(variant);

                variantIndex++;

            });


        document
            .getElementById("variantsContainer")
            .addEventListener("click", function (e) {

                if (e.target.classList.contains("remove-variant")) {

                    const variant =
                        e.target.closest(".variant-row");

                    variant.remove();

                }

            });

    </script>

}